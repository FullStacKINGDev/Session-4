# Copy this file to .env and fill in real values. .env is gitignored;
# .env.example is committed so the required variables are documented
# without exposing real secrets (Session 19 Slide 9).

PORT=5000
MONGODB_URI=mongodb://localhost:27017/dashboardDB

# Session 19 Slide 5-6: the one demo admin account. Change these before
# this ever runs anywhere but localhost.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Signs the JWTs issued by POST /api/auth/login - anyone with this value
# can mint a valid token, so treat it like a password. Generate your own,
# don't reuse this file's value or the one in backend/.env:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-your-own-64-char-hex-secret
