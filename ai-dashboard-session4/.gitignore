gitignore# ==========================================
# Operating System Files
# ==========================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
.fuse_hidden
.directory
.Trash-*

# ==========================================
# IDEs and Text Editors
# ==========================================
# Visual Studio Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# IntelliJ / WebStorm / PyCharm
.idea/
*.iws

# Sublime Text
*.sublime-project
*.sublime-workspace

# Xcode
build/
DerivedData/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj

# ==========================================
# Dependencies and Package Managers
# ==========================================
node_modules/
jspm_packages/
bower_components/
.npm/
.yarn/

# ==========================================
# Environment Variables and Secrets (CRITICAL)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.secret

# ==========================================
# Logs and Caches
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.cache/
